{
  "manifest_version": 3,
  "name": "PhishGuard AI — Phishing & Clone Detection",
  "version": "1.0.0",
  "description": "Explainable real-time detection of phishing, cloned and impersonating webpages. Analysis runs locally.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard AI",
    "default_icon": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["warning.html"], "matches": ["<all_urls>"] }
  ],
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "phishguard-ai@example.org", "strict_min_version": "115.0" }
  }
}
